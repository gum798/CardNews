# 복사해서 .env로 저장 후 실제 값 입력. .env는 절대 커밋 금지 (.gitignore에 포함됨)
#
# [다계정] 계정(프로필)마다 src/profiles/<key>.js 가 있고, 자격증명은 접두사 키로 구분한다.
#   기본 프로필 newshana : 아래 접두사 없는 키를 그대로 사용 (기존 호환)
#   추가 프로필           : <ENVPREFIX>_ 접두사 키만 사용 (폴백 없음 — 안 넣으면 발행하지 않음)
# 실행 시 CARDNEWS_PROFILE=healthhana 처럼 지정 (launchd plist의 EnvironmentVariables에 설정).

# 동작 플래그 (프로필별로 NEWSHANA_DRY_RUN 처럼 덮어쓸 수 있음)
# DRY_RUN=1 : 인스타 실발행 대신 로컬 생성 + 텔레그램 보고만.
# AUTO_PUBLISH=1 : 잡이 일일 한도 내에서 승인 없이 자동 발행 (초과분은 텔레그램 수동).
DRY_RUN=1
AUTO_PUBLISH=1


# ② Meta 앱 (docs/setup-guide.md §2)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=

# ④ 텔레그램 봇 (§4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ③ Cloudflare R2 (§3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cardnews-assets
R2_PUBLIC_URL=

# AI는 Claude Code 구독 인증 사용 (API 키 불필요).
# curator가 `claude -p --output-format json`을 호출 — config에 바이너리 전체 경로 지정.
CLAUDE_BIN=

# 표지 배경 사진: Pixabay 이미지 API 키 (무료). https://pixabay.com/api/docs/ 에서 로그인 시 표시.
# 비워두면 사진 없이 그래픽 표지로 진행.
PIXABAY_KEY=

# 유튜브 쇼츠 자동 업로드 (OAuth). CLIENT_ID/SECRET은 Google Cloud OAuth "데스크톱 앱" 자격증명.
# REFRESH_TOKEN은 `node scripts/youtube-auth.mjs` 실행으로 1회 발급. 비워두면 유튜브 업로드 건너뜀.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=


# ───────────────────────────────────────────────────────────────
# 추가 계정: 건강하나 (프로필 healthhana, 09시·21시 발행)
# 이 접두사 키가 비어 있으면 그 프로필은 발행하지 않고 안전 종료한다
# (기존 뉴스하나 토큰으로 폴백되지 않음 — 엉뚱한 계정 발행 방지).
#
# 인스타: 새 IG 비즈니스 계정을 Meta 앱에 Instagram 테스터로 추가 → 초대 수락 → 토큰 생성
#         이후 `CARDNEWS_PROFILE=healthhana node scripts/ig-verify.mjs --write` 로 USER_ID 자동 기입
HEALTHHANA_IG_USER_ID=
HEALTHHANA_IG_ACCESS_TOKEN=
HEALTHHANA_IG_APP_SECRET=

# 유튜브: 새 채널로 로그인한 상태에서 `CARDNEWS_PROFILE=healthhana node scripts/youtube-auth.mjs`
# CLIENT_ID/SECRET은 기존 것을 재사용해도 되고, 비워두면 공용 값을 쓰지 않으니 반드시 채울 것.
HEALTHHANA_YOUTUBE_CLIENT_ID=
HEALTHHANA_YOUTUBE_CLIENT_SECRET=
HEALTHHANA_YOUTUBE_REFRESH_TOKEN=

# 텔레그램: 롱 폴링은 토큰당 한 프로세스만 가능하므로 계정마다 별도 봇 권장 (@BotFather로 생성).
# 챗 ID는 같은 사람이면 기존과 동일해도 된다.
HEALTHHANA_TELEGRAM_BOT_TOKEN=
HEALTHHANA_TELEGRAM_CHAT_ID=

HEALTHHANA_DRY_RUN=1
HEALTHHANA_AUTO_PUBLISH=1
