# 복사해서 .env로 저장 후 실제 값 입력. .env는 절대 커밋 금지 (.gitignore에 포함됨)

# ② Meta 앱 (docs/setup-guide.md §2)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=

# ④ 텔레그램 봇 (§4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ③ Cloudflare R2 (§3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cardnews-assets
R2_PUBLIC_URL=

# AI는 Claude Code 구독 인증 사용 (API 키 불필요).
# curator가 `claude -p --output-format json`을 호출 — config에 바이너리 전체 경로 지정.
CLAUDE_BIN=
