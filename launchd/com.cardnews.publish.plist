<?xml version="1.0" encoding="UTF-8"?>
<!-- 프로세스 A: 매일 08:00 · 19:00 발행 사이클 (1회 실행 후 종료). 3주제 각 1건 수집→선별→자동 발행. -->
<!-- launchd는 슬립 중 놓친 실행을 깨어날 때 캐치업한다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cardnews.publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/seojeonghwa/project/CardNews/src/jobs/publish-cycle.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/seojeonghwa/project/CardNews</string>

  <!-- 아침 08:00 · 저녁 19:00 두 번 실행 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>19</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/publish.log</string>
</dict>
</plist>
