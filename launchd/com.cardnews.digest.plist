<?xml version="1.0" encoding="UTF-8"?>
<!-- 프로세스 A: 매일 09:00 다이제스트 잡 (1회 실행 후 종료). launchd는 슬립 후 놓친 잡을 캐치업한다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cardnews.digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/seojeonghwa/project/CardNews/src/jobs/daily-digest.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/seojeonghwa/project/CardNews</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/digest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/digest.log</string>
</dict>
</plist>
