<?xml version="1.0" encoding="UTF-8"?>
<!-- 하나 브이로그 생성 → 텔레그램 전송. 자동 발행하지 않는다. -->
<!-- 낮 11시(지금 하는 일) / 저녁 20시(오늘 있었던 일). 뉴스 슬롯(06·18시)과 겹치지 않게 배치. -->
<!-- 실패해도 뉴스 발행에 영향이 없으므로 재시도 창은 두지 않는다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cardnews.vlog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <!-- 시각으로 슬롯을 정한다: 18시 이전이면 낮, 이후면 저녁 -->
    <string>cd /Users/seojeonghwa/project/CardNews &amp;&amp; VLOG_SLOT=$([ $(date +%H) -lt 18 ] &amp;&amp; echo day || echo evening) /opt/homebrew/bin/node src/jobs/vlog-cycle.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/seojeonghwa/project/CardNews</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- 회사망(SK C&C) SSL검사 루트인증서 신뢰. 없으면 TTS·이미지 API가 전부 실패한다. -->
    <key>NODE_EXTRA_CA_CERTS</key>
    <string>/Users/seojeonghwa/project/CardNews/certs/corp-root.pem</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/vlog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/vlog.log</string>
</dict>
</plist>
