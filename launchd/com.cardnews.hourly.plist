<?xml version="1.0" encoding="UTF-8"?>
<!-- 프로세스 A: 매시간 정각 수집 잡 (1회 실행 후 종료). 3주제 각 1건 수집→선별→텔레그램 전송. -->
<!-- launchd는 슬립 중 놓친 실행을 깨어날 때 캐치업한다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cardnews.hourly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/seojeonghwa/project/CardNews/src/jobs/hourly-collect.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/seojeonghwa/project/CardNews</string>

  <!-- 매시간 정각(분=0)에 실행 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/hourly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/seojeonghwa/project/CardNews/out/hourly.log</string>
</dict>
</plist>
